{
  "name": "worldchat",
  "version": "0.1.0",
  "private": true,
  "description": "A video chat world you reshape by talking: Claude rewrites the shared scene as people describe changes.",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local server/index.js",
    "dev:cc": "USE_CLAUDE_CODE=1 node --env-file-if-exists=.env.local server/index.js",
    "dev:mock": "MOCK_CLAUDE=1 node server/index.js",
    "dev:remote": "node tools/remote.mjs",
    "dev:remote:cc": "USE_CLAUDE_CODE=1 node tools/remote.mjs",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "test": "node test/e2e.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@mediapipe/tasks-vision": "^1.2.3",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "playwright-core": "^1.65.1",
    "vite": "^8.3.8"
  }
}
